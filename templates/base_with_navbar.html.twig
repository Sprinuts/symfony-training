{% extends 'base.html.twig' %}

{% block navbar %}
<nav class="navbar">
    <div class="navbar-container">
        <a href="{{ path('welcome') }}" class="navbar-brand">Symfony Training</a>
        <ul class="navbar-links">
            <li><a href="{{ path('app_logout') }}">Logout</a></li>
        </ul>
    </div>
</nav>
<style>
    .navbar {
        background: #fff;
        color: #222;
        padding: 0.5rem 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        margin-bottom: 2rem;
    }
    .navbar-container {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.5rem;
    }
    .navbar-brand {
        font-size: 1.4rem;
        font-weight: bold;
        color: #050505ff;
        text-decoration: none;
        letter-spacing: 1px;
    }
    .navbar-links {
        list-style: none;
        display: flex;
        gap: 1.2rem;
        margin: 0;
        padding: 0;
    }
    .navbar-links li {
        display: inline;
    }
    .navbar-links a {
        color: #222;
        text-decoration: none;
        font-size: 1rem;
        padding: 0.3rem 0.7rem;
        border-radius: 4px;
        transition: background 0.15s, color 0.15s;
    }
    .navbar-links a:hover {
        background: #e9ecef;
        color: #007bff;
    }
    @media (max-width: 600px) {
        .navbar-container {
            flex-direction: column;
            align-items: flex-start;
        }
        .navbar-links {
            flex-direction: column;
            gap: 0.5rem;
            width: 100%;
        }
        .navbar-links a {
            display: block;
            width: 100%;
        }
    }
</style>
{% endblock %}